{
  "name": "530-parkside",
  "version": "1.0.0",
  "private": true,
  "description": "The public record of 530 Parkside Avenue, Brooklyn — built daily from NYC Open Data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "update": "npm run fetch && npm run build && npm run check",
    "serve": "node --run build && node -e \"const{createServer}=require('node:http'),{readFile}=require('node:fs'),{extname,join}=require('node:path');createServer((q,s)=>{const p=join('dist',q.url==='/'?'index.html':q.url.split('?')[0]);readFile(p,(e,d)=>{if(e){s.writeHead(404).end('not found');return}s.writeHead(200,{'content-type':{'.html':'text/html','.css':'text/css','.js':'text/javascript','.json':'application/json','.xml':'application/xml'}[extname(p)]||'text/plain'}).end(d)})}).listen(8788,()=>console.log('http://localhost:8788'))\"",
    "check": "node scripts/check.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
